{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "Request rate by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service) (rate(lab_http_server_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "5xx ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service) (rate(lab_http_server_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum by (service) (rate(lab_http_server_requests_total[5m])), 0.001)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "p95 request latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(lab_http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    }
  ],
  "schemaVersion": 41,
  "tags": ["sre-lab", "red"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "SRE Lab / Service RED",
  "uid": "sre-lab-red",
  "version": 1
}
